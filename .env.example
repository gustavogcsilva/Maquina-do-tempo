# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - MÁQUINA DO TEMPO (PORTFÓLIO & PRODUÇÃO GRATUITA)
# ==============================================================================

# 1. Servidor e Sessão
PORT=5000
NODE_ENV=development
SESSION_SECRET=gere_uma_chave_aleatoria_com_ao_menos_32_bytes_aqui
CAPSULE_ENCRYPTION_KEY=gere_uma_chave_base64_de_32_bytes_aqui
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://seu-frontend.vercel.app

# 2. Banco de Dados PostgreSQL (100% Gratuito no Supabase)
DATABASE_URL=postgresql://postgres.seuid:suasenha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.seuid:suasenha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# 3. Autenticação Google OAuth (Gratuita no Google Cloud Console)
GOOGLE_CLIENT_ID=seu_client_id_google.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=seu_client_id_google.apps.googleusercontent.com
VITE_API_URL=/api

# 4. Envio de E-mail 100% Gratuito (Resend - 3.000 envios/mês grátis)
# Cadastre-se gratuitamente em https://resend.com (sem cartão de crédito)
RESEND_API_KEY=re_sua_chave_resend_aqui
EMAIL_FROM=Máquina do Tempo <onboarding@resend.dev>

# (Opcional: SMTP alternativo gratuito como Brevo ou Gmail)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=seu_email@dominio.com
# SMTP_PASS=sua_senha_smtp

# 5. Envio de WhatsApp 100% Gratuito
# Opção A: WhatsApp Cloud API Oficial da Meta (1.000 conversas/mês gratuitas)
WHATSAPP_ACCESS_TOKEN=seu_meta_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=seu_meta_phone_id

# Opção B: CallMeBot Gateway (Gratuito, basta enviar mensagem para o bot obter a chave)
CALLMEBOT_API_KEY=sua_apikey_callmebot

# 6. Agendador Automático de Despacho (Worker)
CAPSULE_SCHEDULER_INTERVAL_MS=30000
