generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String    @id @default(uuid())
  name     String
  email    String    @unique
  password String
  capsules Capsule[]
}

model Capsule {
  id             String   @id @default(uuid())
  title          String
  content        String
  unlockAt       DateTime
  isOpened       Boolean  @default(false)
  recipientEmail String
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
}
